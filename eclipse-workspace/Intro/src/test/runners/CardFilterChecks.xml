<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Card filter checks only. No RetryListener: a failed check is a result, not something to run again
     (AllTestsGlobal.xml, which has it, runs the old tests).
     Run with:  mvn test "-Dsurefire.suiteXmlFiles=src/test/runners/CardFilterChecks.xml"
     One CI shard (a TestNG group):  add "-Dgroups=CardBrands"   (the groups are listed in tests/CardFilterChecks.java; CardChecks = all of them)
     One search term:  add "-DcardChecks.terms=Headphones"
     data-provider-thread-count: the search terms of one test run 2 at a time (two browsers, so Amazon is not hit by many at once). -->
<suite name="CardFilterChecks" data-provider-thread-count="2">
  <listeners>
    <listener class-name="main.java.amazonfilterapplicatione2e.reporting.TestListenerUpdated"/>
  </listeners>
  <test name="Card filter checks">
    <classes>
      <class name="test.java.tests.CardFilterChecks"/>
    </classes>
  </test>
</suite>
