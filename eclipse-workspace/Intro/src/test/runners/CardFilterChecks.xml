<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Card filter checks only. RetryListener is on, like in AllTestsGlobal.xml: a test is run once more after a technical
     error (assertion failures are not retried, so a failed check is still a result).
     OLD: no RetryListener in this suite.
     Run with:  mvn test "-Dsurefire.suiteXmlFiles=src/test/runners/CardFilterChecks.xml"
     One CI shard (a TestNG group):  add "-Dgroups=CardSeller"   (the groups are listed in tests/CardFilterChecks.java; CardChecks = all of them)
     One search term:  add "-DcardChecks.terms=Headphones"
     data-provider-thread-count: the search terms of one test run 2 at a time (two browsers, so Amazon is not hit by many at once). -->
<suite name="CardFilterChecks" data-provider-thread-count="2">
  <listeners>
    <listener class-name="test.java.retry.RetryListener"/>
    <listener class-name="main.java.amazonfilterapplicatione2e.reporting.TestListenerUpdated"/>
  </listeners>
  <test name="Card filter checks">
    <classes>
      <class name="test.java.tests.CardFilterChecks"/>
    </classes>
  </test>
</suite>
