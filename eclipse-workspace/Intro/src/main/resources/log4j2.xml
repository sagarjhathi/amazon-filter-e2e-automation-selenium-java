<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    
    <Appenders>

    <Console name="Console" target="SYSTEM_OUT">
        <PatternLayout pattern="%d{HH:mm:ss} [%t] %-5level %X{testName} %logger - %msg%n"/>
    </Console>

    <Routing name="RoutingAppender">
    <Routes pattern="$${ctx:logFileName}">
        <!-- Lines logged while no test is running (no logFileName) are dropped, not written into some test's log -->
        <Route key="$${ctx:logFileName}">
            <Null name="NoTest"/>
        </Route>
        <Route>
            <File name="FileAppender-${ctx:logFileName}"
                  fileName="${ctx:logPath}/${ctx:logFileName}.log">
                <PatternLayout pattern="%d{HH:mm:ss} [%t] %-5level %X{testName} - %msg%n"/>
            </File>
        </Route>
    </Routes>
</Routing>

</Appenders>
    
    
   <Loggers>
    <Root level="info">
        <AppenderRef ref="Console"/>
        <AppenderRef ref="RoutingAppender"/>
    </Root>
</Loggers>

</Configuration>